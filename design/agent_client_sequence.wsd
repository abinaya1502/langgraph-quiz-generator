@startuml sequence_diagram
autonumber 1.0

actor Client
participant "src/app.py" as App
participant "src/models/request_dto.py" as AgentRequest
participant "src/router/agent_routes.py" as Router
participant "src/services/agent_service.py" as Service
participant "src/utils/guardrils.py" as Guardrils
participant "src/agents/main_agent.py" as MainAgent
participant "src/agents/main_prompt.py" as MainSystemPrompt
participant "src/agents/state.py" as State
participant "src/agents/middleware.py" as Middleware
participant "src/agents/quiz_run_agent.py" as QuizAgent
participant "src/agents/review_run_agent.py" as ReviewAgent
participant "src/tools/quiz_agent.py" as QuizAgentTool
participant "src/tools/quiz_prompt.py" as QuizSystemPrompt
participant "src/tools/review_agent.py" as ReviewAgentTool
participant "src/tools/review_prompt.py" as ReviewSystemPrompt
Participant "src/utils/llm_client.py" as Llm
Participant "src/utils/bedrock_client.py" as Bedrock



